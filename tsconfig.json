{
  "compilerOptions": {
    "target": "ES2023", "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext", "moduleResolution": "Bundler", "allowImportingTsExtensions": true,
    "jsx": "react-jsx", "strict": true, "noEmit": true, "skipLibCheck": true,
    "verbatimModuleSyntax": true, "types": ["node", "vite/client"]
  },
  "include": ["apps/**/*.ts", "apps/**/*.tsx", "packages/**/*.ts"]
}
