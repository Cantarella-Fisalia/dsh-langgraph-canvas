{
  "name": "vis4agent-workspace",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "node scripts/dev/start.mjs",
    "dev:api": "node --watch apps/backend/src/server.ts",
    "dev:web": "vite --config apps/frontend/vite.config.ts",
    "build": "node scripts/build/frontend.mjs",
    "check": "tsc --noEmit",
    "acceptance:preflight": "node scripts/acceptance/preflight.mjs",
    "test": "node scripts/dev/test.mjs"
  },
  "dependencies": {
    "@xyflow/react": "^12.8.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  },
  "description": "LangGraph visual development plugin for DeepSeek Harness: source graphs, current-session AI explanations, reviewed editing and undo.",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "dsh",
    "langgraph",
    "ai-agents",
    "multi-agent",
    "visualization",
    "developer-tools"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Cantarella-Fisalia/vis4agent.git"
  },
  "homepage": "https://github.com/Cantarella-Fisalia/vis4agent#readme",
  "bugs": {
    "url": "https://github.com/Cantarella-Fisalia/vis4agent/issues"
  }
}
