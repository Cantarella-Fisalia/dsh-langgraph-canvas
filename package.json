{
  "name": "dsh-langgraph-canvas-workspace",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "node scripts/dev/start.mjs",
    "dev:api": "node --watch apps/backend/src/server.ts",
    "dev:web": "vite --config apps/frontend/vite.config.ts",
    "build": "node scripts/build/frontend.mjs",
    "check": "tsc --noEmit",
    "acceptance:preflight": "node scripts/acceptance/preflight.mjs",
    "test": "node scripts/dev/test.mjs",
    "release:package": "node scripts/release/package.mjs",
    "release:verify": "node scripts/release/verify.mjs"
  },
  "dependencies": {
    "@xyflow/react": "^12.8.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  },
  "description": "Unofficial community LangGraph canvas plugin for DeepSeek Harness. Independently maintained; not affiliated with or endorsed by DeepSeek or LangChain.",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "dsh",
    "langgraph",
    "ai-agents",
    "multi-agent",
    "visualization",
    "developer-tools"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Cantarella-Fisalia/dsh-langgraph-canvas.git"
  },
  "homepage": "https://github.com/Cantarella-Fisalia/dsh-langgraph-canvas#readme",
  "bugs": {
    "url": "https://github.com/Cantarella-Fisalia/dsh-langgraph-canvas/issues"
  }
}
